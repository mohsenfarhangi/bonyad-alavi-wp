{
  "name": "bonyad-alavi/alavi-form-engine",
  "description": "Extensible code-first WordPress form engine",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.3",
    "phpoffice/phpspreadsheet": "5.9.0",
    "tecnickcom/tc-lib-pdf": "8.73.6"
  },
  "autoload": {
    "psr-4": {
      "BonyadAlavi\\FormEngine\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "tc-lib-pdf-fonts": [
      "[ -d vendor/tecnickcom/tc-lib-pdf-font ] && make -C vendor/tecnickcom/tc-lib-pdf-font deps fonts || true"
    ],
    "post-install-cmd": [
      "@tc-lib-pdf-fonts"
    ],
    "post-update-cmd": [
      "@tc-lib-pdf-fonts"
    ],
    "post-autoload-dump": [
      "@tc-lib-pdf-fonts"
    ]
  }
}
